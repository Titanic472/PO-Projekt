game:{ //category starts with name:{, ensure to close with } and not to add spaces between data values, max line size is 256 chars
screenY:i:60;//screen size for drawing game 60x230 - fullscr
screenX:i:230;//leave 0 for auto size based on terminal size 
starSpawnChance:i:30; // values are key:type:value; types are i - integer, f - float, s - string
hunterSpawnChance:i:10;// everything after ; is ignored as comment
maxHunterCount:i:1;
hunterDamagePerLife:i:1;
hunterLifeIncrease:f:0.025; //increase of hunter bounces with time
hunterCountIncrease:f:0.2; //increase max number of hunters over time
time:i:80;
targetScore:i:15;
seed:i:261937;//leave 0 for random
fogStart:i:-1; //fog starts after that amount of ticks have passed, -1 disables fog
fogSpreadRate:f:0;
fogFOV:i:0;
}
player:{
color:s:"GRAY"; //available colors: YELLOW, GRAY, RED, MAGENTA, BLUE, GREEN every other value gives white
health:i:10;
baseSpeed:f:1;
maxSpeed:f:3;
sprite_right_x:i:3;
sprite_right_y:i:3;
sprite_left_x:i:3;
sprite_left_y:i:3;
sprite_up_x:i:3;
sprite_up_y:i:3;
sprite_down_x:i:3;
sprite_down_y:i:3;
animationFrames:i:2;
sprite_right:s:"\  >}>/  "; 
sprite_right_1:s:" | >}> | ";//every next animation frame is encoded with _frameNumber, starting from 1 for second frame 
sprite_left:s:"  /<{<  \";
sprite_left_1:s:" | <{< | ";
sprite_up:s:" ^ /#\ ^ ";
sprite_up_1:s:" ^ -#- ^ ";
sprite_down:s:" . \#/ 7 ";
sprite_down_1:s:" . -#- 7 ";
}
star:{
color:s:"YELLOW";
health:i:1;
baseSpeed:f:0.5;//ensure there are numbers that give proper int after multiplication by int
maxSpeed:f:0.5;//max Speed is used only when using speed abilities
sprite_right_x:i:1;
sprite_right_y:i:1;
sprite_left_x:i:1;
sprite_left_y:i:1;
sprite_up_x:i:1;
sprite_up_y:i:1;
sprite_down_x:i:1;
sprite_down_y:i:1;
animationFrames:i:1;
sprite_right:s:"*";
sprite_left:s:"*";
sprite_up:s:"*";
sprite_down:s:"*";
}
hunters:{
count:i:4; //number of hunters in the level
1:{
color:s:"BLUE";
health:i:2;//health is number of bounces needed to destroy the hunter
baseSpeed:f:0.5;
maxSpeed:f:3;
sprite_right_x:i:3;
sprite_right_y:i:1;
sprite_left_x:i:3;
sprite_left_y:i:1;
sprite_up_x:i:0;
sprite_up_y:i:0;
sprite_down_x:i:0;
sprite_down_y:i:0;
animationFrames:i:1;
sprite_right:s:"H#>";
sprite_left:s:"<#H";
sprite_up:s:"";//hunters don't have up/down sprites
sprite_down:s:"";//ensure to add every direction sprite, even empty
}
2:{
color:s:"MAGENTA";
health:i:1;//health is number of bounces needed to destroy the hunter
baseSpeed:f:1;
maxSpeed:f:2;
sprite_right_x:i:3;
sprite_right_y:i:1;
sprite_left_x:i:3;
sprite_left_y:i:1;
sprite_up_x:i:0;
sprite_up_y:i:0;
sprite_down_x:i:0;
sprite_down_y:i:0;
animationFrames:i:1;
sprite_right:s:"H#>";
sprite_left:s:"<#H";
sprite_up:s:"";//hunters don't have up/down sprites
sprite_down:s:"";//ensure to add every direction sprite, even empty
}
3:{
color:s:"RED";
health:i:6;
baseSpeed:f:0.34;
maxSpeed:f:2;
sprite_right_x:i:4;
sprite_right_y:i:3;
sprite_left_x:i:4;
sprite_left_y:i:3;
sprite_up_x:i:0;
sprite_up_y:i:0;
sprite_down_x:i:0;
sprite_down_y:i:0;
animationFrames:i:2;
sprite_right:s:" \ H>{}> /  ";
sprite_right_1:s:"  |H>{}>  | ";
sprite_left:s:"H / <{}<  \ ";
sprite_left_1:s:"H|  <{}< |  ";
sprite_up:s:"";
sprite_up_1:s:"";
sprite_down:s:"";
sprite_down_1:s:"";
}
4:{
color:s:"GREEN";
health:i:2;
baseSpeed:f:0.5;
maxSpeed:f:0.5;
sprite_right_x:i:4;
sprite_right_y:i:1;
sprite_left_x:i:4;
sprite_left_y:i:1;
sprite_up_x:i:0;
sprite_up_y:i:0;
sprite_down_x:i:0;
sprite_down_y:i:0;
animationFrames:i:1;
sprite_right:s:"H)#>";
sprite_left:s:"<#(H";
sprite_up:s:"";
sprite_down:s:"";
}
}
scoreWeights:{
pointsPerHealth:i:1200; //divided by amount of health left
pointsPerTime:i:1500; //divided by amount of time left
pointsPerScore:i:1000; //only matters on defeat, otherwise oll points are granted
}
albatross:{
sprite_right_x:i:7;
sprite_right_y:i:5;
sprite_left_x:i:0;
sprite_left_y:i:0;
sprite_up_x:i:0;
sprite_up_y:i:0;
sprite_down_x:i:0;
sprite_down_y:i:0;
animationFrames:i:8;
sprite_right:s:"  #\      #|  >>####>   #|    #/   ";//albatross always move right
sprite_right_1:s:"   #|     #|  >>####>   #|     #|  ";
sprite_right_2:s:"   #|     #|  >>####>   #|     #|  ";
sprite_right_3:s:"  #\      #|  >>####>   #|    #/   ";
sprite_right_4:s:"  #\      #|  >>####>   #|    #/   ";
sprite_right_5:s:"  #\      #\  >>####>   #/    #/   ";
sprite_right_6:s:"  #\      #\  >>####>   #/    #/   ";
sprite_right_7:s:"  #\      #|  >>####>   #|    #/   ";
sprite_left:s:"";
sprite_left_1:s:"";//every frame for other directiosn must be present even if empty
sprite_left_2:s:"";
sprite_left_3:s:"";
sprite_left_4:s:"";
sprite_left_5:s:"";
sprite_left_6:s:"";
sprite_left_7:s:"";
sprite_up:s:"";
sprite_up_1:s:"";
sprite_up_2:s:"";
sprite_up_3:s:"";
sprite_up_4:s:"";
sprite_up_5:s:"";
sprite_up_6:s:"";
sprite_up_7:s:"";
sprite_down:s:"";
sprite_down_1:s:"";
sprite_down_2:s:"";
sprite_down_3:s:"";
sprite_down_4:s:"";
sprite_down_5:s:"";
sprite_down_6:s:"";
sprite_down_7:s:"";
}
level:{
name:s:"The faster - the better";//level name is displayed on level selection screen
}